<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".FinanzasApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Finanzas">

        <activity
            android:name=".ui.inicio.InicioActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Siempre se abre desde Inicio: volver o tocar "Inicio" en su barra la cierra. -->
        <activity
            android:name=".ui.operaciones.OperacionesActivity"
            android:exported="false"
            android:parentActivityName=".ui.inicio.InicioActivity" />

        <!-- adjustResize: con el teclado abierto, el formulario se puede desplazar hasta Guardar. -->
        <activity
            android:name=".ui.formulario.FormularioActivity"
            android:exported="false"
            android:parentActivityName=".ui.inicio.InicioActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
