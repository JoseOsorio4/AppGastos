<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de Operaciones: categoría, descripción, tipo e importe con signo. Al tocarla se abre el detalle. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Finanzas.Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iconoCategoria"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/fondo_circulo"
            android:importantForAccessibility="no"
            android:padding="9dp"
            app:tint="@android:color/white"
            tools:src="@drawable/ic_categoria_alimentacion" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textStyle="bold"
                tools:text="Almuerzo" />

            <TextView
                android:id="@+id/textoCategoriaYTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Alimentación · Gasto" />
            <TextView
                android:id="@+id/textoOriginalUsd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/textoMonto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            tools:text="-Q 30.00" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
