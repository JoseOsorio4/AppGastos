<?xml version="1.0" encoding="utf-8"?>
<!-- Inicio: cabecera verde con saldo y períodos, tarjetas con datos del período y barra inferior. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_cabecera"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/saldo_disponible"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/color_sobre_cabecera_secundario" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/opcionTema"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tema"
                android:textColor="@color/color_sobre_cabecera" />
        </LinearLayout>

        <!-- Saldo histórico de la tabla Usuario: no depende del período elegido. -->
        <TextView
            android:id="@+id/textoSaldoDisponible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/color_sobre_cabecera"
            android:textSize="34sp"
            android:textStyle="bold"
            tools:text="Q 2,845.00" />

        <include
            android:id="@+id/chipsPeriodo"
            layout="@layout/chips_periodo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textoErrorInicial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/error_inicializacion"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/avisoRecalculo"
                style="@style/Widget.Finanzas.Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textoAvisoRecalculo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/aviso_recalculo"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <TextView
                        android:id="@+id/textoErrorRecalculo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/error_recalculo"
                        android:textColor="?attr/colorError"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botonRecalcularSaldo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/recalcular_saldo" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Ingresos y gastos juntos, como en la maqueta. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tarjetaIngresos"
                    style="@style/Widget.Finanzas.Tarjeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:text="@string/ingresos"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            app:drawableStartCompat="@drawable/ic_ingreso"
                            app:drawableTint="@color/color_ingreso" />

                        <TextView
                            android:id="@+id/textoIngresos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/color_ingreso"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Q 3,500.00" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tarjetaGastos"
                    style="@style/Widget.Finanzas.Tarjeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:text="@string/gastos"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            app:drawableStartCompat="@drawable/ic_gasto"
                            app:drawableTint="@color/color_gasto" />

                        <TextView
                            android:id="@+id/textoGastos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/color_gasto"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Q 655.00" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Ingresos − gastos del intervalo; no se confunde con el saldo. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaResultado"
                style="@style/Widget.Finanzas.Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/resultado_periodo"
                        android:textAppearance="?attr/textAppearanceLabelLarge" />

                    <TextView
                        android:id="@+id/textoResultado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold"
                        tools:text="+Q 2,845.00" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaAnillo"
                style="@style/Widget.Finanzas.Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gastos_por_categoria"
                        android:textAppearance="@style/TextAppearance.Finanzas.Etiqueta" />

                    <FrameLayout
                        android:id="@+id/contenedorAnillo"
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp">

                        <gt.edu.umg.finanzas.app.ui.inicio.GraficoAnilloView
                            android:id="@+id/graficoGastos"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- El centro del anillo muestra el gasto del período, no el balance. -->
                        <!--
                            Medidas fijas para quedar dentro del hueco del anillo: con letra grande el texto se
                            reduce en lugar de salirse. El mínimo va en dp para que la escala no lo duplique.
                            El mismo total se lee completo en la tarjeta Gastos.
                        -->
                        <LinearLayout
                            android:layout_width="130dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center_horizontal"
                            android:importantForAccessibility="no"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="28dp"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/gastos_del_periodo"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:autoSizeMaxTextSize="12sp"
                                app:autoSizeMinTextSize="8dp"
                                app:autoSizeTextType="uniform"
                                tools:ignore="SpUsage" />

                            <TextView
                                android:id="@+id/textoTotalGastosAnillo"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:maxLines="1"
                                android:textAppearance="?attr/textAppearanceTitleLarge"
                                android:textStyle="bold"
                                app:autoSizeMaxTextSize="22sp"
                                app:autoSizeMinTextSize="10dp"
                                app:autoSizeTextType="uniform"
                                tools:text="Q 655.00" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/textoSinGastos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingVertical="32dp"
                        android:text="@string/sin_gastos_periodo"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <!-- LeyendaGastos llena estas filas: categoría, porcentaje e importe. -->
                    <LinearLayout
                        android:id="@+id/contenedorLeyenda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <include
                android:id="@+id/tarjetaTasa"
                layout="@layout/tarjeta_tasa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!-- Diagnóstico del Inc. 0: confirma qué versión del JAR del core usa la app. -->
            <include
                android:id="@+id/tarjetaClima"
                layout="@layout/tarjeta_clima"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <include
                android:id="@+id/tarjetaReflexion"
                layout="@layout/tarjeta_reflexion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/textoConexionCore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="finanzas-core 0.3.0" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/barraNavegacion"
        layout="@layout/barra_navegacion" />
</LinearLayout>
