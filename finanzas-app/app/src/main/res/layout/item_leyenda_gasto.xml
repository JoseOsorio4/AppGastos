<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila de la leyenda del anillo: el color del círculo coincide con su segmento. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <ImageView
        android:id="@+id/iconoCategoria"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/fondo_circulo"
        android:importantForAccessibility="no"
        android:padding="8dp"
        app:tint="@android:color/white"
        tools:src="@drawable/ic_categoria_alimentacion" />

    <TextView
        android:id="@+id/textoNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        tools:text="Alimentación" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textoPorcentaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="42 %" />

        <TextView
            android:id="@+id/textoMonto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textStyle="bold"
            tools:text="Q 275.00" />
    </LinearLayout>
</LinearLayout>
