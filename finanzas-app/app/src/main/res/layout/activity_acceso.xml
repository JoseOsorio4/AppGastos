<?xml
    version="1.0"
    encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView
                android:id="@+id/tituloAcceso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preparando_acceso"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:layout_marginBottom="24dp"/>
            <EditText
                android:id="@+id/entradaNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:hint="@string/nombre_acceso"
                android:inputType="textPersonName"
                android:maxLength="40"
                android:saveEnabled="true"
                android:visibility="gone"/>
            <EditText
                android:id="@+id/entradaPinActual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:hint="@string/pin_actual"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:saveEnabled="false"
                android:visibility="gone"/>
            <EditText
                android:id="@+id/entradaPinNuevo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:hint="@string/pin_nuevo"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:saveEnabled="false"
                android:visibility="gone"/>
            <EditText
                android:id="@+id/entradaPinConfirmacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:hint="@string/pin_confirmacion"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:saveEnabled="false"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/avisoPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/aviso_pin"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:layout_marginVertical="16dp"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/errorAcceso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorError"
                android:accessibilityLiveRegion="polite"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonAcceso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/continuar_acceso"
                android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonConfigurarPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/configurar_pin"
                android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonContinuar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/continuar_sin_pin"
                android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonDesactivarPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/desactivar_pin"
                android:visibility="gone"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
