<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Finanzas.TarjetaServicio"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/relleno_servicio">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="@string/clima_jutiapa"
            android:textAppearance="@style/TextAppearance.Finanzas.Etiqueta"
            app:drawableStartCompat="@drawable/ic_clima"
            app:drawableTint="?attr/colorPrimary" />
        <TextView
            android:id="@+id/textoClima"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/separacion_servicio"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.Finanzas.ValorServicio" />
        <TextView
            android:id="@+id/textoEstadoClima"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/separacion_servicio"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
        <TextView
            android:id="@+id/enlaceOpenMeteo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/separacion_servicio"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="@string/atribucion_clima"
            android:textAppearance="?attr/textAppearanceBodySmall" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonReintentarClima"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reintentar_clima" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
