<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Finanzas.TarjetaServicio"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/relleno_servicio">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reflexion_dia"
            android:textAppearance="@style/TextAppearance.Finanzas.Etiqueta"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            app:drawableStartCompat="@drawable/ic_reflexion"
            app:drawableTint="?attr/colorPrimary" />
        <LinearLayout
            android:id="@+id/contenidoReflexion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/textoReflexion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_servicio"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Finanzas.Reflexion" />
            <TextView
                android:id="@+id/textoFuenteReflexion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_servicio"
                android:textAppearance="?attr/textAppearanceBodySmall" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonReintentarReflexion"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/actualizar_reflexion" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonVisibilidadReflexion"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/separacion_servicio"
            android:text="@string/ocultar_reflexion" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
