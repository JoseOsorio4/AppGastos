<resources>
    <!-- DayNight usa Sistema, Claro u Oscuro según PreferenciaTema. -->
    <style name="Theme.Finanzas" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primario</item>
        <item name="colorOnPrimary">@color/color_sobre_primario</item>
        <item name="colorPrimaryContainer">@color/color_primario_contenedor</item>
        <item name="colorOnPrimaryContainer">@color/color_sobre_primario_contenedor</item>
        <item name="colorSecondary">@color/color_acento</item>
        <item name="colorOnSecondary">@color/color_sobre_acento</item>
        <item name="colorSecondaryContainer">@color/color_primario_contenedor</item>
        <item name="colorOnSecondaryContainer">@color/color_sobre_primario_contenedor</item>
        <item name="android:colorBackground">@color/color_fondo</item>
        <item name="colorSurface">@color/color_superficie</item>
        <item name="colorOnSurface">@color/color_texto</item>
        <item name="colorOnSurfaceVariant">@color/color_texto_secundario</item>
        <item name="colorOutline">@color/color_borde</item>
        <item name="colorError">@color/color_error</item>
        <item name="android:windowBackground">@color/color_fondo</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Finanzas.Metadatos</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Finanzas.Detalle</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Finanzas.Cuerpo</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Finanzas.Control</item>
        <item name="textInputOutlinedStyle">@style/Widget.Finanzas.Campo</item>
    </style>

    <!-- Chips de período sobre la cabecera verde. -->
    <!-- Material 3 pinta una superficie blanca debajo del chip; se quita para que se vea el fondo verde. -->
    <style name="Widget.Finanzas.ChipPeriodo" parent="Widget.Material3.Chip.Filter">
        <item name="chipSurfaceColor">@android:color/transparent</item>
        <item name="chipBackgroundColor">@color/fondo_chip_periodo</item>
        <item name="android:textColor">@color/texto_chip_periodo</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="Widget.Finanzas.Tarjeta" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/color_superficie</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
    </style>

    <!--
        Texto bajo los iconos de la barra inferior. Con letra grande, "Operaciones" se partía en dos líneas:
        se queda en una y se reduce solo lo necesario. El tamaño máximo en sp sigue la escala del sistema.
    -->
    <style name="Widget.Finanzas.EtiquetaBarra" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">@color/color_sobre_cabecera</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">9sp</item>
        <item name="autoSizeMaxTextSize">14sp</item>
    </style>

    <style name="TextAppearance.Finanzas.Etiqueta" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/color_texto_secundario</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="TextAppearance.Finanzas.Metadatos" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_texto_secundario</item>
    </style>
    <style name="TextAppearance.Finanzas.Detalle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.Finanzas.Cuerpo" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">17sp</item>
    </style>
    <style name="TextAppearance.Finanzas.Control" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">15sp</item>
    </style>
    <style name="TextAppearance.Finanzas.Categoria" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
    </style>
    <style name="TextAppearance.Finanzas.ValorServicio" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/texto_valor_servicio</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_primario</item>
    </style>
    <style name="TextAppearance.Finanzas.Reflexion" parent="TextAppearance.Finanzas.Cuerpo">
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Widget.Finanzas.TarjetaServicio" parent="Widget.Finanzas.Tarjeta">
        <item name="cardBackgroundColor">@color/color_superficie_servicio</item>
        <item name="strokeColor">@color/color_borde_servicio</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
    </style>
    <style name="Widget.Finanzas.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintTextAppearance">@style/TextAppearance.Finanzas.Metadatos</item>
        <item name="counterTextAppearance">@style/TextAppearance.Finanzas.Metadatos</item>
        <item name="errorTextAppearance">@style/TextAppearance.Finanzas.Metadatos</item>
    </style>
</resources>
